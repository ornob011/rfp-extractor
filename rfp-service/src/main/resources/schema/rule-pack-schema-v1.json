{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule Pack Definition Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "pack_version",
    "rfp_type",
    "rules"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^bd-govt-[a-z-]+-v[0-9]+$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rfp_type": {
      "type": "string",
      "enum": [
        "ICT",
        "WORKS",
        "CONSULTANCY",
        "GOODS",
        "UNKNOWN"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ruleDefinition"
      }
    }
  },
  "definitions": {
    "ruleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "pack",
        "version",
        "severity",
        "check_type",
        "evidence_path",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BD-[A-Z]+-[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "pack": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "FATAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "check_type": {
          "type": "string",
          "enum": [
            "structural",
            "semantic"
          ]
        },
        "condition": {
          "type": "string"
        },
        "evidence_path": {
          "type": "string"
        },
        "llm_prompt": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 5
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check_type": {
                "const": "structural"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "check_type": {
                "const": "semantic"
              }
            }
          },
          "then": {
            "required": [
              "llm_prompt"
            ]
          }
        }
      ]
    }
  }
}
